 PART B:
 B1 ,

 void main() {
String city = 'Kigali';  // variable stored string value
print(city.length); // output = 6, becouse length function count the size or number of charactor are in string variable.
print(city[city.length - 1]);// output = "i" ,becouse city.length-1 = 5 and this five is index of i in the variable of city.
print(city.substring(2, 4));// output = "ga" ,becouse it extracts charactors from 2 up to 4.
print(city.toUpperCase().indexOf('A')); output = 3 , becouse it converted Kigali to KIGALI and find or get the index number of "A" to printed.
print(city.contains('k'));// output = flase , becouse it is checking lowcase while there is only upercase.
print('$city.length');// output = Kigali.length , becouse this  length  outputed  as plain text.
print('${city.length}');// output = 6 , becouse it count the length and after number size counted converted into String charactor "6"
print(city * 2);//  output = Kigalikigaki, becouse it seams to double due to *2 which make the reapation of the string twice due to numberof times "2".
city.toUpperCase();// converted string to UpperCase
print(city);// output = Kigali , becouse that create new string coused existing one not changed.
print(city.replaceAll('i', '!'));//output = k!gal! , becouse this replace the specified charactor with another specified.
print('5' + 5.toString()); output = 55 , becouse that converted 5 to string and joins those two string which gives "55".
print(int.parse('5') + 5);// output = 10 , becouse it converted string into intage and peform add opeartion which gives 10.
}
