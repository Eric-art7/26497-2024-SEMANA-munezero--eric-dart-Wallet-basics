// the following is the method or function
void main() {

// two line follow are variables stored the values assigned to them  
int x = 7; // your D
int y = 97; // your T
var z = x * 2 + y ~/ 4;

// here output will be 45 , becouse it takes the value obtained from  "x * 2 + y ~/ 4;" and ad value of x whicj is 7.
z += x;
print(z);
// the output will be flase, becouse it is isEven only have to behave true or flase  becouse z now is 45 that is reason.
print(z.isEven);
// the output will 457 as string becouse of the $ converted those value in z and x into string ang joins them together.
print('$z' + '$x');
}
