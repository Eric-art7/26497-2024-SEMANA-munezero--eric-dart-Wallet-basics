void main() {
int x = 7; // your D
String result = '';
while (x > 0) {
if (x % 2 == 0) {
result += 'E';
} else {
result += 'O';
}
x -= 3;
}
print(result);
print(result.length);
print(result.isEmpty ? 'nothing' : result[0]);
}
the output will be 
oeo
3
0
