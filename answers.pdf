PART A:
A1 line by line predictions.

// the following is the method or function have diffrent opartion on two values 
void main() {
// two line follow are variables stored the values assigned to them    
int a = 17;
int b = 5;

// the following  output will be the 3.4, becouse this operator "/" always return  double datatype.
print(a / b);

// the following output will be the  3 , becouse this opartion "~/" will return intages only.
print(a ~/ b);

// the following output will be the  2 , becouse this "%" returns the remainder of devision in intage.
print(a % b);

// the following output will be the  3 , becouse we have ~a and "%" operator with devisor 5 which is postive  and becouse -17 sits 3 unit above -20 so remainder = 2.
print(-a % b);

// the following output will be the -3, becouse the we have negative number to devide postive number with this opartion"~/" which returns result in intage.
print(-a ~/ b);

//the following output will be the -17,becouse the dot "." grabs onto 17 first and  dart groups it as - (17.abs()) instead of (-).abs()
print(-17.abs());

// the following output will be flase , becouse it is comparation which give true or flase.
print(0.1 + 0.2 == 0.3);

// the following output will be true , becouse it is comparation which give true or flase
print(10 == 10.0);
}
